# Public canonical site URL used for QR codes, sitemap, Open Graph.
# Must be the production URL — QR codes printed on physical posters depend on this.
NEXT_PUBLIC_SITE_URL=https://hartlandhistorical.ca

# Optional short URL prefix for QR fallbacks (e.g., a Bitly or self-hosted redirector).
# Leave blank to use NEXT_PUBLIC_SITE_URL directly.
NEXT_PUBLIC_SHORT_URL=

# Society contact email displayed on the Contact page.
NEXT_PUBLIC_CONTACT_EMAIL=nursekennedy@hotmail.com
